##
# BIOS files can live outside the app as long as they are served through a URL.
#
# Browser builds cannot read arbitrary system paths directly. For production,
# point this at a web-accessible BIOS route:
# VITE_BIOS_BASE_URL=https://example.com/bios/
#
# For local Vite dev/preview only, point this at a system folder. Vite will
# expose it as /external-bios/ and the app will use that URL automatically.
# VITE_BIOS_FS_PATH=/absolute/path/to/bios

# For the Tauri desktop app, this native path is read by Rust directly.
# VISUALADVANCE_BIOS_PATH=/absolute/path/to/bios
